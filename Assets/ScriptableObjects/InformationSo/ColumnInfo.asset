%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a674721d0dea422d8343d482a0155d94, type: 3}
  m_Name: ColumnInfo
  m_EditorClassIdentifier: 
  symbolPrefab: {fileID: 4765392048150037027, guid: c4a69b26abce47a44b63456606d7a4ae,
    type: 3}
  rotationAxis: 1
  titles:
  - Columns
  - "\u05E2\u05DE\u05D5\u05D3\u05D9\u05DD"
  - "\u0627\u0644\u0623\u0639\u0645\u062F\u0629"
  - "\u041A\u043E\u043B\u043E\u043D\u043D\u044B"
  informationDialogue:
  - informationDialoguePerLanguages:
    - dialogueText: The columns on the stone symbolize the structure of the Temple,
        possibly its gateways or inner sanctuaries.
      dialogueAudioClip: {fileID: 8300000, guid: dda9357900af68e45a31ae5701f2f99a,
        type: 3}
    - dialogueText: "\u05D4\u05B8\u05E2\u05B7\u05DE\u05BC\u05D5\u05BC\u05D3\u05B4\u05D9\u05DD
        \u05E9\u05C1\u05B6\u05E2\u05B7\u05DC \u05D4\u05B8\u05D0\u05B6\u05D1\u05B6\u05DF
        \u05DE\u05B0\u05E1\u05B7\u05DE\u05BC\u05B0\u05DC\u05B4\u05D9\u05DD \u05D0\u05B6\u05EA
        \u05DE\u05B4\u05D1\u05B0\u05E0\u05B5\u05D4 \u05D1\u05BC\u05B5\u05D9\u05EA
        \u05D4\u05B7\u05DE\u05BC\u05B4\u05E7\u05B0\u05D3\u05BC\u05B8\u05E9\u05C1,
        \u05D0\u05D5\u05BC\u05DC\u05B7\u05D9 \u05D0\u05B6\u05EA \u05E9\u05C1\u05B7\u05E2\u05B2\u05E8\u05B5\u05D9
        \u05D4\u05B7\u05DB\u05BC\u05B0\u05E0\u05B4\u05D9\u05E1\u05B8\u05D4 \u05D0\u05D5\u05B9
        \u05D0\u05B6\u05EA \u05E7\u05B9\u05D3\u05B6\u05E9\u05C1 \u05D4\u05B7\u05E7\u05BC\u05B8\u05D3\u05B8\u05E9\u05C1\u05B4\u05D9\u05DD."
      dialogueAudioClip: {fileID: 8300000, guid: ceb66cb321d51584cae6032a17c02a36,
        type: 3}
    - dialogueText: "\u062A\u0631\u0645\u0632 \u0627\u0644\u0623\u0639\u0645\u062F\u0629
        \u0627\u0644\u0645\u0648\u062C\u0648\u062F\u0629 \u0639\u0644\u0649 \u0627\u0644\u062D\u062C\u0631
        \u0625\u0644\u0649 \u0628\u0646\u064A\u0629 \u0627\u0644\u0645\u0639\u0628\u062F\u060C
        \u0648\u0631\u0628\u0645\u0627 \u0628\u0648\u0627\u0628\u0627\u062A\u0647
        \u0623\u0648 \u062D\u0631\u0645\u0627\u062A\u0647 \u0627\u0644\u062F\u0627\u062E\u0644\u064A\u0629."
      dialogueAudioClip: {fileID: 8300000, guid: 9dab31f4149d1364dbb357f1fec47264,
        type: 3}
    - dialogueText: "\u041A\u043E\u043B\u043E\u043D\u043D\u044B \u043D\u0430 \u043A\u0430\u043C\u043D\u0435
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442
        \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u0425\u0440\u0430\u043C\u0430,
        \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0435\u0433\u043E \u0432\u0440\u0430\u0442\u0430
        \u0438\u043B\u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
        \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0430."
      dialogueAudioClip: {fileID: 8300000, guid: a37429cadb95ccf429405a61ec371554,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: "They represent a connection to the sacred space.\r"
      dialogueAudioClip: {fileID: 8300000, guid: 5eef5d581da2645458cd3bec17a4b893,
        type: 3}
    - dialogueText: "\u05D4\u05B5\u05DD \u05DE\u05B0\u05E1\u05B7\u05DE\u05BC\u05B0\u05DC\u05B4\u05D9\u05DD
        \u05D7\u05B4\u05D1\u05BC\u05D5\u05BC\u05E8 \u05DC\u05B7\u05DE\u05BC\u05B6\u05E8\u05B0\u05D7\u05B8\u05D1
        \u05D4\u05B7\u05E7\u05BC\u05B8\u05D3\u05D5\u05B9\u05E9\u05C1."
      dialogueAudioClip: {fileID: 8300000, guid: 23068401036445f45b6d23dc73d1e220,
        type: 3}
    - dialogueText: "\u0648\u0647\u0645 \u064A\u0645\u062B\u0644\u0648\u0646 \u0627\u062A\u0635\u0627\u0644\u0627\u064B
        \u0628\u0627\u0644\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u0642\u062F\u0633."
      dialogueAudioClip: {fileID: 8300000, guid: d0f6ae9fcb0e0b049835bf043d896909,
        type: 3}
    - dialogueText: "\u041E\u043D\u0438 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442
        \u0441\u0432\u044F\u0437\u044C \u0441\u043E \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u043C
        \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E\u043C."
      dialogueAudioClip: {fileID: 8300000, guid: db5d7bd24cd497a4fad582299da4e7ad,
        type: 3}
