%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a674721d0dea422d8343d482a0155d94, type: 3}
  m_Name: ShowbreadInfo
  m_EditorClassIdentifier: 
  symbolPrefab: {fileID: 7663169855986836706, guid: 013a9600b4a404a4bafc7730f3711d74,
    type: 3}
  rotationAxis: 0
  titles:
  - Table of Showbread
  - "\u05E9\u05D5\u05DC\u05D7\u05DF \u05D4\u05DC\u05D7\u05DD"
  - "\u0645\u0627\u0626\u062F\u0629 \u062E\u0628\u0632 \u0627\u0644\u062A\u0642\u062F\u0645\u0629"
  - "\u0421\u0442\u043E\u043B \u0445\u043B\u0435\u0431\u043E\u0432 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F"
  informationDialogue:
  - informationDialoguePerLanguages:
    - dialogueText: This symbol may represent the showbread, placed on a special
        table in the Temple.
      dialogueAudioClip: {fileID: 8300000, guid: 8a40f72792ab80341bd5d2a37e27a176,
        type: 3}
    - dialogueText: "\u05E1\u05B5\u05DE\u05B6\u05DC \u05E9\u05C1\u05B6\u05D9\u05BC\u05B4\u05EA\u05BC\u05B8\u05DB\u05B5\u05DF
        \u05E9\u05C1\u05B6\u05DE\u05BC\u05B0\u05D9\u05B7\u05E6\u05BC\u05B5\u05D2
        \u05D0\u05B6\u05EA \u05DC\u05B6\u05D7\u05B6\u05DD \u05D4\u05B7\u05E4\u05BC\u05B8\u05E0\u05B4\u05D9\u05DD,
        \u05E9\u05C1\u05B6\u05D4\u05BB\u05E0\u05BC\u05B7\u05D7 \u05E2\u05B7\u05DC
        \u05E9\u05C1\u05BB\u05DC\u05B0\u05D7\u05B8\u05DF \u05DE\u05B0\u05D9\u05BB\u05D7\u05B8\u05D3
        \u05D1\u05BC\u05B0\u05D1\u05B5\u05D9\u05EA \u05D4\u05B7\u05DE\u05BC\u05B4\u05E7\u05B0\u05D3\u05BC\u05B8\u05E9\u05C1."
      dialogueAudioClip: {fileID: 8300000, guid: 6c473ef1a1fdca347a1b9a833bd143b1,
        type: 3}
    - dialogueText: "\u0642\u062F \u064A\u0645\u062B\u0644 \u0647\u0630\u0627 \u0627\u0644\u0631\u0645\u0632
        \u062E\u0628\u0632 \u0627\u0644\u062A\u0642\u062F\u0645\u0629 \u0627\u0644\u0645\u0648\u0636\u0648\u0639
        \u0639\u0644\u0649 \u0637\u0627\u0648\u0644\u0629 \u062E\u0627\u0635\u0629
        \u0641\u064A \u0627\u0644\u0647\u064A\u0643\u0644."
      dialogueAudioClip: {fileID: 8300000, guid: 5e5c20ff0e2a60a4caa78bb1de7d60b4,
        type: 3}
    - dialogueText: "\u042D\u0442\u043E\u0442 \u0441\u0438\u043C\u0432\u043E\u043B
        \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
        \u0441\u043E\u0431\u043E\u0439 \u0445\u043B\u0435\u0431\u044B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
        \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u043D\u044B\u0435 \u043D\u0430
        \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0442\u043E\u043B
        \u0432 \u0425\u0440\u0430\u043C\u0435."
      dialogueAudioClip: {fileID: 8300000, guid: a2568355248eced4783ae52e140f51f2,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: "It hints at ritual continuity and God's constant presence.\r"
      dialogueAudioClip: {fileID: 8300000, guid: 21583d36b4467604791941555924799a,
        type: 3}
    - dialogueText: "\u05D6\u05B6\u05D4\u05D5\u05BC \u05E8\u05B6\u05DE\u05B6\u05D6
        \u05DC\u05B0\u05E7\u05B4\u05D9\u05BC\u05D5\u05BC\u05DD \u05D4\u05B7\u05E4\u05BC\u05BB\u05DC\u05B0\u05D7\u05B8\u05DF
        \u05D5\u05BC\u05DC\u05B0\u05E0\u05D5\u05B9\u05DB\u05B0\u05D7\u05D5\u05BC\u05EA
        \u05D4\u05B8\u05D0\u05B5\u05DC \u05D1\u05BC\u05B4\u05EA\u05B0\u05DE\u05B4\u05D9\u05D3\u05D5\u05BC\u05EA."
      dialogueAudioClip: {fileID: 8300000, guid: c4964bd6408109543a6f605762605da0,
        type: 3}
    - dialogueText: "\u0648\u0647\u0648 \u064A\u0634\u064A\u0631 \u0625\u0644\u0649
        \u0627\u0633\u062A\u0645\u0631\u0627\u0631\u064A\u0629 \u0627\u0644\u0637\u0642\u0648\u0633
        \u0648\u0648\u062C\u0648\u062F \u0627\u0644\u0644\u0647 \u0627\u0644\u062F\u0627\u0626\u0645."
      dialogueAudioClip: {fileID: 8300000, guid: 47ff6f5d65f460644aa6b259aca72494,
        type: 3}
    - dialogueText: "\u042D\u0442\u043E \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0442
        \u043D\u0430 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u044C
        \u0440\u0438\u0442\u0443\u0430\u043B\u043E\u0432 \u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0435
        \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0411\u043E\u0433\u0430."
      dialogueAudioClip: {fileID: 8300000, guid: 2adb6f6b9fb92ac4c8eb033f3ea08e43,
        type: 3}
