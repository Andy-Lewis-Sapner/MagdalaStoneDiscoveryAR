%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a674721d0dea422d8343d482a0155d94, type: 3}
  m_Name: StoneInfo
  m_EditorClassIdentifier: 
  symbolPrefab: {fileID: 0}
  rotationAxis: 0
  titles:
  - Magdala Stone
  - "\u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D0"
  - "\u062D\u062C\u0631 \u0645\u0627\u062C\u062F\u0627\u0644\u0627"
  - "\u041A\u0430\u043C\u0435\u043D\u044C \u041C\u0430\u0433\u0434\u0430\u043B\u0430"
  informationDialogue:
  - informationDialoguePerLanguages:
    - dialogueText: The Magdala Stone was discovered in 2009 at the center of the
        ancient Migdal Synagogue.
      dialogueAudioClip: {fileID: 8300000, guid: f9fa0f02ead687f4990419d52775ec8c,
        type: 3}
    - dialogueText: "\u05D0\u05B6\u05D1\u05B6\u05DF \u05DE\u05B7\u05D2\u05B0\u05D3\u05BC\u05B7\u05DC\u05B8\u05D0
        \u05D4\u05B4\u05EA\u05B0\u05D2\u05BC\u05B7\u05DC\u05BC\u05B0\u05EA\u05B8\u05D4
        \u05D1\u05BC\u05B4\u05E9\u05C1\u05B0\u05E0\u05B7\u05EA 9002 \u05D1\u05BC\u05B0\u05DE\u05B6\u05E8\u05B0\u05DB\u05BC\u05B7\u05D6
        \u05D1\u05BC\u05B5\u05D9\u05EA \u05D4\u05B7\u05DB\u05BC\u05B0\u05E0\u05B6\u05E1\u05B6\u05EA
        \u05D4\u05B8\u05E2\u05B7\u05EA\u05BC\u05B4\u05D9\u05E7 \u05D1\u05BC\u05B7\u05DE\u05BC\u05B4\u05D2\u05B0\u05D3\u05BC\u05B8\u05DC."
      dialogueAudioClip: {fileID: 8300000, guid: 2bd2aea1bfff0ee45a9bd27494c2e3fe,
        type: 3}
    - dialogueText: "\u062A\u0645 \u0627\u0643\u062A\u0634\u0627\u0641 \u062D\u062C\u0631
        \u0627\u0644\u0645\u062C\u062F\u0644 \u0641\u064A \u0639\u0627\u0645 9002
        \u0641\u064A \u0648\u0633\u0637 \u0643\u0646\u064A\u0633 \u0645\u062C\u062F\u0644
        \u0627\u0644\u0642\u062F\u064A\u0645."
      dialogueAudioClip: {fileID: 8300000, guid: 63ad44e74a9597847835206756e031c4,
        type: 3}
    - dialogueText: "\u041A\u0430\u043C\u0435\u043D\u044C \u041C\u0430\u0433\u0434\u0430\u043B\u0430
        \u0431\u044B\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D
        \u0432 2009 \u0433\u043E\u0434\u0443 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
        \u0434\u0440\u0435\u0432\u043D\u0435\u0439 \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0438
        \u041C\u0438\u0433\u0434\u0430\u043B\u044C."
      dialogueAudioClip: {fileID: 8300000, guid: a4e8f0f365f93a74885de379f7eaed14,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: It dates back to the early first century CE.
      dialogueAudioClip: {fileID: 8300000, guid: f7231cdd1aafb4c4298597ed02f3e36e,
        type: 3}
    - dialogueText: "\u05D4\u05B4\u05D9\u05D0 \u05E0\u05D5\u05B9\u05E6\u05B0\u05E8\u05B8\u05D4
        \u05E2\u05D5\u05B9\u05D3 \u05D1\u05BC\u05B7\u05DE\u05BC\u05B5\u05D0\u05B8\u05D4
        \u05D4\u05B8\u05E8\u05B4\u05D0\u05E9\u05C1\u05D5\u05B9\u05E0\u05B8\u05D4
        \u05DC\u05B4\u05E4\u05B0\u05E0\u05B5\u05D9 \u05D4\u05B7\u05E1\u05BC\u05B0\u05E4\u05B4\u05D9\u05E8\u05B8\u05D4."
      dialogueAudioClip: {fileID: 8300000, guid: 64b7ad8cd2bbb0645b66461f3875ef0c,
        type: 3}
    - dialogueText: "\u064A\u0631\u062C\u0639 \u062A\u0627\u0631\u064A\u062E\u0647\u0627
        \u0625\u0644\u0649 \u0623\u0648\u0627\u0626\u0644 \u0627\u0644\u0642\u0631\u0646
        \u0627\u0644\u0623\u0648\u0644 \u0627\u0644\u0645\u064A\u0644\u0627\u062F\u064A."
      dialogueAudioClip: {fileID: 8300000, guid: d1eb934ed8d65ec409032d13d89888d9,
        type: 3}
    - dialogueText: "\u041E\u043D \u0434\u0430\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F
        \u043D\u0430\u0447\u0430\u043B\u043E\u043C \u043F\u0435\u0440\u0432\u043E\u0433\u043E
        \u0432\u0435\u043A\u0430 \u043D\u0430\u0448\u0435\u0439 \u044D\u0440\u044B."
      dialogueAudioClip: {fileID: 8300000, guid: d3e3888b03d506e409453afba33420be,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: It is one of the oldest synagogues found in Israel, noted for
        its well-preserved structure and artifacts.
      dialogueAudioClip: {fileID: 8300000, guid: cc8fc746863bdf545ab6e2c2361577da,
        type: 3}
    - dialogueText: "\u05DE\u05B0\u05D3\u05BB\u05D1\u05BC\u05B8\u05E8 \u05D1\u05BC\u05B0\u05D0\u05B6\u05D7\u05B8\u05D3
        \u05DE\u05B4\u05D1\u05BC\u05B8\u05EA\u05BC\u05B5\u05D9 \u05D4\u05B7\u05DB\u05BC\u05B0\u05E0\u05B6\u05E1\u05B6\u05EA
        \u05D4\u05B8\u05E2\u05B7\u05EA\u05BC\u05B4\u05D9\u05E7\u05B4\u05D9\u05DD
        \u05E9\u05C1\u05B6\u05E0\u05BC\u05B4\u05DE\u05B0\u05E6\u05B0\u05D0\u05D5\u05BC
        \u05D1\u05BC\u05B0\u05D9\u05B4\u05E9\u05C2\u05B0\u05E8\u05B8\u05D0\u05B5\u05DC,
        \u05D5\u05B4\u05D9\u05D3\u05D5\u05BC\u05E2\u05B8\u05D4 \u05D1\u05BC\u05B7\u05DE\u05BC\u05B4\u05D1\u05B0\u05E0\u05B6\u05D4
        \u05D4\u05B7\u05E9\u05BC\u05C1\u05B8\u05DE\u05D5\u05BC\u05E8 \u05D5\u05BC\u05D1\u05B7\u05DE\u05BC\u05B4\u05DE\u05B0\u05E6\u05B8\u05D0\u05B4\u05D9\u05DD
        \u05D4\u05B8\u05D0\u05B7\u05E8\u05B0\u05DB\u05B5\u05D0\u05D5\u05B9\u05DC\u05D5\u05B9\u05D2\u05B4\u05D9\u05BC\u05B4\u05D9\u05DD
        \u05E9\u05C1\u05B6\u05D1\u05BC\u05B8\u05D4\u05BC."
      dialogueAudioClip: {fileID: 8300000, guid: b117b3d53db0ec9408a0f811d6e219a3,
        type: 3}
    - dialogueText: "\u0648\u0647\u0648 \u0623\u062D\u062F \u0623\u0642\u062F\u0645
        \u0627\u0644\u0645\u0639\u0627\u0628\u062F \u0627\u0644\u064A\u0647\u0648\u062F\u064A\u0629
        \u0627\u0644\u0645\u0648\u062C\u0648\u062F\u0629 \u0641\u064A \u0625\u0633\u0631\u0627\u0626\u064A\u0644\u060C
        \u0648\u064A\u0634\u062A\u0647\u0631 \u0628\u0628\u0646\u064A\u062A\u0647
        \u0627\u0644\u0645\u062D\u0641\u0648\u0638\u0629 \u062C\u064A\u062F\u064B\u0627
        \u0648\u0627\u0644\u062A\u062D\u0641 \u0627\u0644\u0645\u0648\u062C\u0648\u062F\u0629
        \u0641\u064A\u0647."
      dialogueAudioClip: {fileID: 8300000, guid: f80e504697975974b893a0ef8d9b58a0,
        type: 3}
    - dialogueText: "\u042D\u0442\u043E \u043E\u0434\u043D\u0430 \u0438\u0437 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0445
        \u0441\u0438\u043D\u0430\u0433\u043E\u0433 \u0432 \u0418\u0437\u0440\u0430\u0438\u043B\u0435,
        \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u0441\u0432\u043E\u0435\u0439
        \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0435\u0439\u0441\u044F
        \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043E\u0439 \u0438 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430\u043C\u0438."
      dialogueAudioClip: {fileID: 8300000, guid: c1763c4d057b7ec47864cd2f0784dacc,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: The stone was likely used as a reading table for Torah scrolls
        during synagogue services.
      dialogueAudioClip: {fileID: 8300000, guid: 8565c5c91132ee3408d5d688b42ddfbf,
        type: 3}
    - dialogueText: "\u05D4\u05B8\u05D0\u05B6\u05D1\u05B6\u05DF \u05E9\u05C1\u05B4\u05DE\u05BC\u05B0\u05E9\u05C1\u05B8\u05D4
        \u05DB\u05BC\u05B0\u05DB\u05B8\u05DC \u05D4\u05B7\u05E0\u05BC\u05B4\u05E8\u05B0\u05D0\u05B6\u05D4
        \u05DB\u05BC\u05B0\u05DE\u05B7\u05E2\u05B2\u05DE\u05B8\u05D3 \u05DC\u05B4\u05E7\u05B0\u05E8\u05B4\u05D9\u05D0\u05B7\u05EA
        \u05DE\u05B0\u05D2\u05B4\u05DC\u05BC\u05D5\u05B9\u05EA \u05EA\u05BC\u05D5\u05B9\u05E8\u05B8\u05D4
        \u05D1\u05BC\u05B0\u05DE\u05B7\u05D4\u05B2\u05DC\u05B7\u05DA\u05B0 \u05D4\u05B7\u05EA\u05BC\u05B0\u05E4\u05B4\u05DC\u05BC\u05D5\u05B9\u05EA
        \u05D1\u05BC\u05B0\u05D1\u05B5\u05D9\u05EA \u05D4\u05B7\u05DB\u05BC\u05B0\u05E0\u05B6\u05E1\u05B6\u05EA."
      dialogueAudioClip: {fileID: 8300000, guid: 69d98cfa949527541a459fa9a208a006,
        type: 3}
    - dialogueText: "\u0648\u0645\u0646 \u0627\u0644\u0645\u0631\u062C\u062D \u0623\u0646
        \u0627\u0644\u062D\u062C\u0631 \u0643\u0627\u0646 \u064A\u0633\u062A\u062E\u062F\u0645
        \u0643\u0637\u0627\u0648\u0644\u0629 \u0644\u0642\u0631\u0627\u0621\u0629
        \u0645\u062E\u0637\u0648\u0637\u0627\u062A \u0627\u0644\u062A\u0648\u0631\u0627\u0629
        \u0623\u062B\u0646\u0627\u0621 \u0627\u0644\u062E\u062F\u0645\u0627\u062A
        \u0627\u0644\u062F\u064A\u0646\u064A\u0629 \u0641\u064A \u0627\u0644\u0643\u0646\u064A\u0633."
      dialogueAudioClip: {fileID: 8300000, guid: 2a4e844db48736e4b9744e9c3035bd20,
        type: 3}
    - dialogueText: "\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043A\u0430\u043C\u0435\u043D\u044C
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
        \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0441\u0442\u043E\u043B\u0438\u043A\u0430
        \u0434\u043B\u044F \u0447\u0442\u0435\u043D\u0438\u044F \u0441\u0432\u0438\u0442\u043A\u043E\u0432
        \u0422\u043E\u0440\u044B \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u043E\u0433\u043E\u0441\u043B\u0443\u0436\u0435\u043D\u0438\u0439
        \u0432 \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0435."
      dialogueAudioClip: {fileID: 8300000, guid: 8eafa2b127337f140af5367d3a512855,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: It features carvings symbolizing the Jerusalem Temple, such as
        a menorah and columns.
      dialogueAudioClip: {fileID: 8300000, guid: a30f5c7a53bd7b9428079b7baca5a4dc,
        type: 3}
    - dialogueText: "\u05D4\u05B8\u05D0\u05B6\u05D1\u05B6\u05DF \u05DE\u05B0\u05E2\u05BB\u05D8\u05BC\u05B6\u05E8\u05B6\u05EA
        \u05D1\u05BC\u05B7\u05D7\u05B2\u05E8\u05B4\u05D9\u05D8\u05D5\u05B9\u05EA
        \u05D4\u05B7\u05DE\u05BC\u05B0\u05E1\u05B7\u05DE\u05BC\u05B0\u05DC\u05D5\u05B9\u05EA
        \u05D0\u05B6\u05EA \u05D1\u05BC\u05B5\u05D9\u05EA \u05D4\u05B7\u05DE\u05BC\u05B4\u05E7\u05B0\u05D3\u05BC\u05B8\u05E9\u05C1
        \u05D1\u05BC\u05B4\u05D9\u05E8\u05D5\u05BC\u05E9\u05C1\u05B8\u05DC\u05B7\u05D9\u05B4\u05DD,
        \u05DB\u05BC\u05B0\u05DE\u05D5\u05B9 \u05DE\u05B0\u05E0\u05D5\u05B9\u05E8\u05B8\u05D4
        \u05D5\u05B0\u05E2\u05B7\u05DE\u05BC\u05D5\u05BC\u05D3\u05B4\u05D9\u05DD."
      dialogueAudioClip: {fileID: 8300000, guid: aae388bfe53b74940957a64825e8c055,
        type: 3}
    - dialogueText: "\u0648\u064A\u0636\u0645 \u0627\u0644\u0645\u0628\u0646\u0649
        \u0646\u0642\u0648\u0634\u064B\u0627 \u062A\u0631\u0645\u0632 \u0625\u0644\u0649
        \u0645\u0639\u0628\u062F \u0627\u0644\u0642\u062F\u0633\u060C \u0645\u062B\u0644
        \u0627\u0644\u0634\u0645\u0639\u062F\u0627\u0646 \u0648\u0627\u0644\u0623\u0639\u0645\u062F\u0629."
      dialogueAudioClip: {fileID: 8300000, guid: 4b38b65b7d5bcf34aa6ed7a58c789ba4,
        type: 3}
    - dialogueText: "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E
        \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0435\u0437\u044C\u0431\u0443,
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0443\u044E
        \u0418\u0435\u0440\u0443\u0441\u0430\u043B\u0438\u043C\u0441\u043A\u0438\u0439
        \u0425\u0440\u0430\u043C, \u0442\u0430\u043A\u0443\u044E \u200B\u200B\u043A\u0430\u043A
        \u043C\u0435\u043D\u043E\u0440\u0430 \u0438 \u043A\u043E\u043B\u043E\u043D\u043D\u044B."
      dialogueAudioClip: {fileID: 8300000, guid: cb8f4d7551c655243822085f9b2ad928,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: The stone helped connect local worshippers spiritually to the
        Temple, which many could not visit.
      dialogueAudioClip: {fileID: 8300000, guid: 79ca7e721f8bbe64e90bfd0d79246819,
        type: 3}
    - dialogueText: "\u05D9\u05B5\u05E9\u05C1 \u05D4\u05B8\u05D0\u05D5\u05B9\u05DE\u05B0\u05E8\u05B4\u05D9\u05DD
        \u05E9\u05C1\u05B6\u05D4\u05B8\u05D0\u05B6\u05D1\u05B6\u05DF \u05E1\u05B4\u05D9\u05BC\u05B0\u05E2\u05B8\u05D4
        \u05E7\u05B6\u05E9\u05C1\u05B6\u05E8 \u05E8\u05D5\u05BC\u05D7\u05B8\u05E0\u05B4\u05D9
        \u05D1\u05BC\u05B5\u05D9\u05DF \u05D4\u05B7\u05DE\u05BC\u05B4\u05EA\u05B0\u05E4\u05BC\u05B7\u05DC\u05BC\u05B0\u05DC\u05B4\u05D9\u05DD
        \u05D4\u05B7\u05DE\u05BC\u05B0\u05E7\u05D5\u05B9\u05DE\u05B4\u05D9\u05BC\u05B4\u05D9\u05DD
        \u05DC\u05B0\u05D1\u05B5\u05D9\u05EA \u05D4\u05B7\u05DE\u05BC\u05B4\u05E7\u05B0\u05D3\u05BC\u05B8\u05E9\u05C1,
        \u05E9\u05C1\u05B6\u05DC\u05BC\u05B9\u05D0 \u05D9\u05B8\u05DB\u05B0\u05DC\u05D5\u05BC
        \u05DC\u05B0\u05D4\u05B7\u05D2\u05BC\u05B4\u05D9\u05E2\u05B7 \u05D0\u05B5\u05DC\u05B8\u05D9\u05D5
        \u05DC\u05B0\u05E2\u05B4\u05EA\u05BC\u05B4\u05D9\u05DD \u05E7\u05B0\u05E8\u05D5\u05B9\u05D1\u05D5\u05B9\u05EA."
      dialogueAudioClip: {fileID: 8300000, guid: 3a2355be76041bd499eaa67cf68cd155,
        type: 3}
    - dialogueText: "\u0633\u0627\u0639\u062F \u0627\u0644\u062D\u062C\u0631 \u0639\u0644\u0649
        \u0631\u0628\u0637 \u0627\u0644\u0645\u0635\u0644\u064A\u0646 \u0627\u0644\u0645\u062D\u0644\u064A\u064A\u0646
        \u0631\u0648\u062D\u064A\u0627 \u0628\u0627\u0644\u0645\u0639\u0628\u062F\u060C
        \u0648\u0627\u0644\u0630\u064A \u0644\u0645 \u064A\u062A\u0645\u0643\u0646
        \u0627\u0644\u0643\u062B\u064A\u0631\u0648\u0646 \u0645\u0646 \u0632\u064A\u0627\u0631\u062A\u0647."
      dialogueAudioClip: {fileID: 8300000, guid: ebef8ff844162404d99cb644741bfc70,
        type: 3}
    - dialogueText: "\u041A\u0430\u043C\u0435\u043D\u044C \u043F\u043E\u043C\u043E\u0433\u0430\u043B
        \u043C\u0435\u0441\u0442\u043D\u044B\u043C \u0432\u0435\u0440\u0443\u044E\u0449\u0438\u043C
        \u0434\u0443\u0445\u043E\u0432\u043D\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C\u0441\u044F
        \u0441 \u0425\u0440\u0430\u043C\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043C\u043D\u043E\u0433\u0438\u0435 \u043D\u0435 \u043C\u043E\u0433\u043B\u0438
        \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u044C."
      dialogueAudioClip: {fileID: 8300000, guid: 1da644f12b906ad4a8abe66590531876,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: Today, the original stone is kept safe, with a replica displayed
        in the synagogue.
      dialogueAudioClip: {fileID: 8300000, guid: 20b3af266f579e34bb6885dac596b22e,
        type: 3}
    - dialogueText: "\u05DB\u05BC\u05B7\u05D9\u05BC\u05D5\u05B9\u05DD \u05D4\u05B8\u05D0\u05B6\u05D1\u05B6\u05DF
        \u05D4\u05B7\u05DE\u05BC\u05B0\u05E7\u05D5\u05B9\u05E8\u05B4\u05D9\u05EA
        \u05E9\u05C1\u05B0\u05DE\u05D5\u05BC\u05E8\u05B8\u05D4 \u05D1\u05BC\u05B0\u05DE\u05B8\u05E7\u05D5\u05B9\u05DD
        \u05D1\u05BC\u05B8\u05D8\u05D5\u05BC\u05D7\u05B7, \u05D5\u05B0\u05D4\u05B6\u05E2\u05B0\u05EA\u05BC\u05B5\u05E7
        \u05E9\u05C1\u05B6\u05DC\u05BC\u05B8\u05D4\u05BC \u05DE\u05BB\u05E6\u05BC\u05B8\u05D2
        \u05D1\u05BC\u05B0\u05D1\u05B5\u05D9\u05EA \u05D4\u05B7\u05DB\u05BC\u05B0\u05E0\u05B6\u05E1\u05B6\u05EA."
      dialogueAudioClip: {fileID: 8300000, guid: c319bc021be54f842b2a53ef5906b740,
        type: 3}
    - dialogueText: "\u0627\u0644\u064A\u0648\u0645\u060C \u064A\u062A\u0645 \u0627\u0644\u0627\u062D\u062A\u0641\u0627\u0638
        \u0628\u0627\u0644\u062D\u062C\u0631 \u0627\u0644\u0623\u0635\u0644\u064A
        \u0641\u064A \u0645\u0643\u0627\u0646 \u0622\u0645\u0646\u060C \u0645\u0639
        \u0639\u0631\u0636 \u0646\u0633\u062E\u0629 \u0637\u0628\u0642 \u0627\u0644\u0623\u0635\u0644
        \u0645\u0646\u0647 \u0641\u064A \u0627\u0644\u0643\u0646\u064A\u0633."
      dialogueAudioClip: {fileID: 8300000, guid: cb70c7553fa040d44bba07bfb4665494,
        type: 3}
    - dialogueText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u043A\u0430\u043C\u0435\u043D\u044C \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
        \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438,
        \u0430 \u0435\u0433\u043E \u043A\u043E\u043F\u0438\u044F \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
        \u200B\u200B\u0432 \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0435."
      dialogueAudioClip: {fileID: 8300000, guid: 113e369e4301fd045bf128458b5a1d90,
        type: 3}
