%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a674721d0dea422d8343d482a0155d94, type: 3}
  m_Name: OilLampInfo
  m_EditorClassIdentifier: 
  symbolPrefab: {fileID: 6029215127343825513, guid: 04c571a828774e143a5df3c499188b83,
    type: 3}
  rotationAxis: 1
  titles:
  - Oil Lamp
  - "\u05DE\u05E0\u05D5\u05E8\u05EA \u05E9\u05DE\u05DF"
  - "\u0645\u0635\u0628\u0627\u062D \u0627\u0644\u0632\u064A\u062A"
  - "\u041C\u0430\u0441\u043B\u044F\u043D\u0430\u044F \u043B\u0430\u043C\u043F\u0430"
  informationDialogue:
  - informationDialoguePerLanguages:
    - dialogueText: "The oil lamps carved on the stone likely symbolize the Temple\u2019s
        ritual purity and ongoing worship."
      dialogueAudioClip: {fileID: 8300000, guid: 5137f07f2ee2c6944b455df989f7fc94,
        type: 3}
    - dialogueText: "\u05DE\u05B0\u05E0\u05D5\u05B9\u05E8\u05D5\u05B9\u05EA \u05D4\u05B7\u05E9\u05BC\u05C1\u05B6\u05DE\u05B6\u05DF
        \u05D4\u05B7\u05D7\u05B2\u05E7\u05D5\u05BC\u05E7\u05D5\u05B9\u05EA \u05E2\u05B7\u05DC
        \u05D4\u05B8\u05D0\u05B6\u05D1\u05B6\u05DF \u05DE\u05B0\u05E1\u05B7\u05DE\u05BC\u05B0\u05DC\u05D5\u05B9\u05EA
        \u05DB\u05BC\u05B0\u05DB\u05B8\u05DC \u05D4\u05B7\u05E0\u05BC\u05B4\u05E8\u05B0\u05D0\u05B6\u05D4
        \u05D0\u05B6\u05EA \u05D4\u05B7\u05D8\u05BC\u05B8\u05D4\u05B3\u05E8\u05B8\u05D4
        \u05D5\u05B0\u05D4\u05B7\u05E4\u05BC\u05BB\u05DC\u05B0\u05D7\u05B8\u05DF
        \u05D4\u05B7\u05DE\u05BC\u05B4\u05EA\u05B0\u05DE\u05B7\u05E9\u05BC\u05C1\u05B5\u05DA\u05B0
        \u05D1\u05BC\u05B0\u05D1\u05B5\u05D9\u05EA \u05D4\u05B7\u05DE\u05BC\u05B4\u05E7\u05B0\u05D3\u05BC\u05B8\u05E9\u05C1."
      dialogueAudioClip: {fileID: 8300000, guid: 4164c4f31eb91fc43bc4e641dde54924,
        type: 3}
    - dialogueText: "\u0645\u0646 \u0627\u0644\u0645\u0631\u062C\u062D \u0623\u0646
        \u062A\u0631\u0645\u0632 \u0645\u0635\u0627\u0628\u064A\u062D \u0627\u0644\u0632\u064A\u062A
        \u0627\u0644\u0645\u0646\u062D\u0648\u062A\u0629 \u0639\u0644\u0649 \u0627\u0644\u062D\u062C\u0631
        \u0625\u0644\u0649 \u0637\u0647\u0627\u0631\u0629 \u0627\u0644\u0645\u0639\u0628\u062F
        \u0627\u0644\u0637\u0642\u0633\u064A\u0629 \u0648\u0627\u0644\u0639\u0628\u0627\u062F\u0629
        \u0627\u0644\u0645\u0633\u062A\u0645\u0631\u0629."
      dialogueAudioClip: {fileID: 8300000, guid: 47e688192794c2d45be262c8ebe7d2dd,
        type: 3}
    - dialogueText: "\u0412\u044B\u0441\u0435\u0447\u0435\u043D\u043D\u044B\u0435
        \u043D\u0430 \u043A\u0430\u043C\u043D\u0435 \u043C\u0430\u0441\u043B\u044F\u043D\u044B\u0435
        \u043B\u0430\u043C\u043F\u044B, \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442
        \u0440\u0438\u0442\u0443\u0430\u043B\u044C\u043D\u0443\u044E \u0447\u0438\u0441\u0442\u043E\u0442\u0443
        \u0425\u0440\u0430\u043C\u0430 \u0438 \u043D\u0435\u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u044E\u0449\u0435\u0435\u0441\u044F
        \u043F\u043E\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435."
      dialogueAudioClip: {fileID: 8300000, guid: 5c39e61f02bd44646a53dd0d0f00b804,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: They may reflect the eternal flame that burned in the Temple,
        representing divine presence and spiritual light.
      dialogueAudioClip: {fileID: 8300000, guid: e3c7476b4a636f342911d2b96f617bcc,
        type: 3}
    - dialogueText: "\u05D4\u05B5\u05DF \u05E2\u05B2\u05E9\u05C2\u05D5\u05BC\u05D9\u05D5\u05B9\u05EA
        \u05DC\u05B0\u05E9\u05C1\u05B7\u05E7\u05BC\u05B5\u05E3 \u05D0\u05B6\u05EA
        \u05D4\u05B8\u05D0\u05D5\u05B9\u05E8 \u05D4\u05B7\u05EA\u05BC\u05B0\u05DE\u05B4\u05D9\u05D3\u05B4\u05D9
        \u05E9\u05C1\u05B6\u05D3\u05BC\u05B8\u05DC\u05B7\u05E7 \u05D1\u05BC\u05B7\u05DE\u05BC\u05B4\u05E7\u05B0\u05D3\u05BC\u05B8\u05E9\u05C1,
        \u05DB\u05BC\u05B0\u05E1\u05B5\u05DE\u05B6\u05DC \u05DC\u05B0\u05E0\u05D5\u05B9\u05DB\u05B0\u05D7\u05D5\u05BC\u05EA
        \u05D0\u05B1\u05DC\u05D5\u05B9\u05E7\u05B4\u05D9\u05EA \u05D5\u05B0\u05D0\u05D5\u05B9\u05E8
        \u05E8\u05D5\u05BC\u05D7\u05B8\u05E0\u05B4\u05D9."
      dialogueAudioClip: {fileID: 8300000, guid: def210b21c06a2b448f7076af742bdee,
        type: 3}
    - dialogueText: "\u0648\u0642\u062F \u062A\u0639\u0643\u0633 \u0647\u0630\u0647
        \u0627\u0644\u062A\u0645\u0627\u062B\u064A\u0644 \u0627\u0644\u0634\u0639\u0644\u0629
        \u0627\u0644\u0623\u0628\u062F\u064A\u0629 \u0627\u0644\u062A\u064A \u0627\u062D\u062A\u0631\u0642\u062A
        \u0641\u064A \u0627\u0644\u0647\u064A\u0643\u0644\u060C \u0648\u0627\u0644\u062A\u064A
        \u062A\u0645\u062B\u0644 \u0627\u0644\u062D\u0636\u0648\u0631 \u0627\u0644\u0625\u0644\u0647\u064A
        \u0648\u0627\u0644\u0646\u0648\u0631 \u0627\u0644\u0631\u0648\u062D\u064A."
      dialogueAudioClip: {fileID: 8300000, guid: b477349b70f28dc44800e9534a488021,
        type: 3}
    - dialogueText: "\u041E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u043E\u0442\u0440\u0430\u0436\u0430\u0442\u044C
        \u0432\u0435\u0447\u043D\u044B\u0439 \u043E\u0433\u043E\u043D\u044C, \u0433\u043E\u0440\u0435\u043B
        \u0432 \u0425\u0440\u0430\u043C\u0435, \u043E\u043B\u0438\u0446\u0435\u0442\u0432\u043E\u0440\u044F\u044F
        \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
        \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0438
        \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u0439 \u0441\u0432\u0435\u0442."
      dialogueAudioClip: {fileID: 8300000, guid: 41c6006789368ce429fa390068bfa7b9,
        type: 3}
