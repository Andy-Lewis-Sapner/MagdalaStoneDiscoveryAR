%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a674721d0dea422d8343d482a0155d94, type: 3}
  m_Name: WheelInfo
  m_EditorClassIdentifier: 
  symbolPrefab: {fileID: 5610231598133753122, guid: e770b50da2776e142ad8d52417185dc9,
    type: 3}
  rotationAxis: 0
  titles:
  - Wheels
  - "\u05D2\u05DC\u05D2\u05DC\u05D9\u05DD"
  - "\u0639\u062C\u0644\u0627\u062A"
  - "\u041A\u043E\u043B\u0435\u0441\u0430"
  informationDialogue:
  - informationDialoguePerLanguages:
    - dialogueText: Two wheels seem to indicate the throne, or perhaps the chariot
        of God.
      dialogueAudioClip: {fileID: 8300000, guid: 22f63cea275562b4f84dd1297abfb741,
        type: 3}
    - dialogueText: "\u05E9\u05C1\u05B0\u05E0\u05B5\u05D9 \u05D4\u05B7\u05D2\u05BC\u05B7\u05DC\u05B0\u05D2\u05BC\u05B7\u05DC\u05BC\u05B4\u05D9\u05DD
        \u05E0\u05B4\u05E8\u05B0\u05D0\u05B4\u05D9\u05DD \u05DB\u05BC\u05B4\u05DE\u05B0\u05E1\u05B7\u05DE\u05BC\u05B0\u05DC\u05B4\u05D9\u05DD
        \u05D0\u05B6\u05EA \u05DB\u05BC\u05B4\u05E1\u05BC\u05B5\u05D0 \u05D4\u05B7\u05DB\u05BC\u05B8\u05D1\u05D5\u05B9\u05D3,
        \u05D0\u05D5\u05B9 \u05D0\u05D5\u05BC\u05DC\u05B7\u05D9 \u05D0\u05B6\u05EA
        \u05DE\u05B6\u05E8\u05B0\u05DB\u05BC\u05B7\u05D1\u05B0\u05EA\u05BC\u05D5\u05B9
        \u05E9\u05C1\u05B6\u05DC \u05D0\u05B1\u05DC\u05D5\u05B9\u05E7\u05B4\u05D9\u05DD."
      dialogueAudioClip: {fileID: 8300000, guid: b7d401d1e3dca574f85dd35c01f67c00,
        type: 3}
    - dialogueText: "\u064A\u0628\u062F\u0648 \u0623\u0646 \u0627\u0644\u0639\u062C\u0644\u062A\u064A\u0646
        \u062A\u0634\u064A\u0631\u0627\u0646 \u0625\u0644\u0649 \u0627\u0644\u0639\u0631\u0634\u060C
        \u0623\u0648 \u0631\u0628\u0645\u0627 \u0625\u0644\u0649 \u0639\u0631\u0628\u0629
        \u0627\u0644\u0644\u0647."
      dialogueAudioClip: {fileID: 8300000, guid: c6bb6d83814543547a0a61d15140dbdf,
        type: 3}
    - dialogueText: "\u0414\u0432\u0430 \u043A\u043E\u043B\u0435\u0441\u0430, \u043F\u043E-\u0432\u0438\u0434\u0438\u043C\u043E\u043C\u0443,
        \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442 \u043F\u0440\u0435\u0441\u0442\u043E\u043B
        \u0438\u043B\u0438, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043A\u043E\u043B\u0435\u0441\u043D\u0438\u0446\u0443
        \u0411\u043E\u0433\u0430."
      dialogueAudioClip: {fileID: 8300000, guid: 68201f38ed9817c4abbd4520a1e491f5,
        type: 3}
  - informationDialoguePerLanguages:
    - dialogueText: "Fire combined with the wheels echoes the prophet Ezekiel\u2019s
        vision of God\u2019s presence and glory."
      dialogueAudioClip: {fileID: 8300000, guid: 4e569f7608808da4ba946362fa75e1f3,
        type: 3}
    - dialogueText: "\u05D4\u05B8\u05D0\u05B5\u05E9\u05C1 \u05D9\u05B7\u05D7\u05B7\u05D3
        \u05E2\u05B4\u05DD \u05D4\u05B7\u05D2\u05BC\u05B7\u05DC\u05B0\u05D2\u05BC\u05B7\u05DC\u05BC\u05B4\u05D9\u05DD
        \u05DE\u05B0\u05D0\u05B7\u05D6\u05B0\u05DB\u05BC\u05B6\u05E8\u05B6\u05EA
        \u05D0\u05B6\u05EA \u05D7\u05B2\u05D6\u05D5\u05B9\u05DF \u05D9\u05B0\u05D7\u05B6\u05D6\u05B0\u05E7\u05B5\u05D0\u05DC
        \u05E2\u05B7\u05DC \u05E0\u05D5\u05B9\u05DB\u05B0\u05D7\u05D5\u05BC\u05EA\u05D5\u05B9
        \u05D5\u05B7\u05D4\u05B2\u05D3\u05B8\u05E8\u05D5\u05B9 \u05E9\u05C1\u05B6\u05DC
        \u05D0\u05B1\u05DC\u05D5\u05B9\u05E7\u05B4\u05D9\u05DD."
      dialogueAudioClip: {fileID: 8300000, guid: ecd034bb035023a4bb5d163d43de251e,
        type: 3}
    - dialogueText: "\u0625\u0646 \u0627\u0644\u0646\u0627\u0631 \u0627\u0644\u0645\u0645\u0632\u0648\u062C\u0629
        \u0628\u0627\u0644\u0639\u062C\u0644\u0627\u062A \u062A\u0639\u0643\u0633
        \u0631\u0624\u064A\u0629 \u0627\u0644\u0646\u0628\u064A \u062D\u0632\u0642\u064A\u0627\u0644
        \u0644\u062D\u0636\u0648\u0631 \u0627\u0644\u0644\u0647 \u0648\u0645\u062C\u062F\u0647."
      dialogueAudioClip: {fileID: 8300000, guid: e84d3c51c9c02d24a9ff78714f217ee6,
        type: 3}
    - dialogueText: "\u041E\u0433\u043E\u043D\u044C \u0432 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438
        \u0441 \u043A\u043E\u043B\u0435\u0441\u0430\u043C\u0438 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
        \u0432\u0438\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0440\u043E\u043A\u0430
        \u0418\u0435\u0437\u0435\u043A\u0438\u0438\u043B\u044F \u043E \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
        \u0438 \u0441\u043B\u0430\u0432\u0435 \u0411\u043E\u0433\u0430."
      dialogueAudioClip: {fileID: 8300000, guid: 90d0d9aece23d2149b031614de94ebf4,
        type: 3}
