--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a26695f223e540b78009fe43b973f5f3, type: 3}
  m_Name: MagdalaStoneQuiz
  m_EditorClassIdentifier: 
  quizId: MagdalaStoneQuiz
  questions:
  - questionsPerLanguage:
    - questionText: Where was the Magdala Stone discovered?
      answers:
      - Jerusalem
      - Magdala
      - Nazareth
      - Capernaum
    - questionText: "\u05D4\u05D9\u05DB\u05DF \u05D4\u05EA\u05D2\u05DC\u05EA\u05D4
        \u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D0?"
      answers:
      - "\u05D9\u05E8\u05D5\u05E9\u05DC\u05D9\u05DD"
      - "\u05DE\u05D2\u05D3\u05DC\u05D0"
      - "\u05E0\u05E6\u05E8\u05EA"
      - "\u05DB\u05E4\u05E8 \u05E0\u05D7\u05D5\u05DD"
    - questionText: "\u0623\u064A\u0646 \u062A\u0645 \u0627\u0643\u062A\u0634\u0627\u0641
        \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644\u061F"
      answers:
      - "\u0627\u0644\u0642\u062F\u0633"
      - "\u0645\u062C\u062F\u0644\u0627"
      - "\u0627\u0644\u0646\u0627\u0635\u0631\u0629"
      - "\u0643\u0641\u0631\u0646\u0627\u062D\u0648\u0645"
    - questionText: "\u0413\u0434\u0435 \u0431\u044B\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D
        \u041C\u0430\u0433\u0434\u0430\u043B\u044C\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C?"
      answers:
      - "\u0418\u0435\u0440\u0443\u0441\u0430\u043B\u0438\u043C"
      - "\u041C\u0430\u0433\u0434\u0430\u043B\u0430"
      - "\u041D\u0430\u0437\u0430\u0440\u0435\u0442"
      - "\u041A\u0444\u0430\u0440 \u041D\u0430\u0445\u0443\u043C"
    correctAnswerIndex: 1
  - questionsPerLanguage:
    - questionText: What is the Magdala Stone believed to have been used for?
      answers:
      - Altar for sacrifices
      - "Base for a statue\r"
      - "Reading desk for Torah scrolls\r"
      - Decorative floor tile
    - questionText: "\u05DC\u05DE\u05D4 \u05DE\u05D0\u05DE\u05D9\u05E0\u05D9\u05DD
        \u05E9\u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D4 \u05E9\u05D9\u05DE\u05E9\u05D4?"
      answers:
      - "\u05DE\u05D6\u05D1\u05D7 \u05DC\u05E7\u05D5\u05E8\u05D1\u05E0\u05D5\u05EA"
      - "\u05D1\u05E1\u05D9\u05E1 \u05DC\u05E4\u05E1\u05DC"
      - "\u05E9\u05D5\u05DC\u05D7\u05DF \u05E7\u05E8\u05D9\u05D0\u05D4 \u05DC\u05E1\u05E4\u05E8\u05D9
        \u05EA\u05D5\u05E8\u05D4"
      - "\u05D0\u05E8\u05D9\u05D7\u05D9 \u05E8\u05E6\u05E4\u05D4 \u05D3\u05E7\u05D5\u05E8\u05D8\u05D9\u05D1\u05D9\u05D9\u05DD"
    - questionText: "\u0645\u0627 \u0647\u0648 \u0627\u0644\u0630\u064A \u064A\u064F\u0639\u062A\u0642\u062F
        \u0623\u0646 \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644 \u0643\u0627\u0646
        \u064A\u064F\u0633\u062A\u062E\u062F\u0645 \u0645\u0646 \u0623\u062C\u0644\u0647\u061F"
      answers:
      - "\u0645\u0630\u0628\u062D \u0644\u0644\u062A\u0636\u062D\u064A\u0627\u062A"
      - "\u0642\u0627\u0639\u062F\u0629 \u0644\u0644\u062A\u0645\u062B\u0627\u0644"
      - "\u0637\u0627\u0648\u0644\u0629 \u0642\u0631\u0627\u0621\u0629 \u0645\u062E\u0637\u0648\u0637\u0627\u062A
        \u0627\u0644\u062A\u0648\u0631\u0627\u0629"
      - "\u0628\u0644\u0627\u0637 \u0623\u0631\u0636\u064A\u0627\u062A \u0645\u0632\u062E\u0631\u0641"
    - questionText: "\u0414\u043B\u044F \u043A\u0430\u043A\u0438\u0445 \u0446\u0435\u043B\u0435\u0439
        \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
        \u041A\u0430\u043C\u0435\u043D\u044C \u041C\u0430\u0433\u0434\u0430\u043B\u044B?"
      answers:
      - "\u0410\u043B\u0442\u0430\u0440\u044C \u0434\u043B\u044F \u0436\u0435\u0440\u0442\u0432\u043E\u043F\u0440\u0438\u043D\u043E\u0448\u0435\u043D\u0438\u0439"
      - "\u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0434\u043B\u044F
        \u0441\u0442\u0430\u0442\u0443\u0438"
      - "\u0421\u0442\u043E\u043B \u0434\u043B\u044F \u0447\u0442\u0435\u043D\u0438\u044F
        \u0441\u0432\u0438\u0442\u043A\u043E\u0432 \u0422\u043E\u0440\u044B"
      - "\u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F
        \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430"
    correctAnswerIndex: 2
  - questionsPerLanguage:
    - questionText: Which symbol is prominently featured on the front of the Magdala
        Stone?
      answers:
      - Star of David
      - Seven-branched menorah
      - Lion of Judah
      - Olive tree
    - questionText: "\u05D0\u05D9\u05D6\u05D4 \u05E1\u05DE\u05DC \u05DE\u05D5\u05E4\u05D9\u05E2
        \u05D1\u05D0\u05D5\u05E4\u05DF \u05D1\u05D5\u05DC\u05D8 \u05D1\u05D7\u05D6\u05D9\u05EA
        \u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D4?"
      answers:
      - "\u05DE\u05D2\u05DF \u05D3\u05D5\u05D3"
      - "\u05DE\u05E0\u05D5\u05E8\u05D4 \u05D1\u05E2\u05DC\u05EA \u05E9\u05D1\u05E2\u05D4
        \u05E7\u05E0\u05D9\u05DD"
      - "\u05D0\u05E8\u05D9\u05D4 \u05D9\u05D4\u05D5\u05D3\u05D4"
      - "\u05E2\u05E5 \u05D6\u05D9\u05EA"
    - questionText: "\u0645\u0627 \u0647\u0648 \u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0630\u064A
        \u064A\u0638\u0647\u0631 \u0628\u0634\u0643\u0644 \u0628\u0627\u0631\u0632
        \u0639\u0644\u0649 \u0648\u0627\u062C\u0647\u0629 \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644\u061F"
      answers:
      - "\u0646\u062C\u0645\u0629 \u062F\u0627\u0648\u062F"
      - "\u0634\u0645\u0639\u062F\u0627\u0646 \u0630\u0648 \u0633\u0628\u0639\u0629
        \u0641\u0631\u0648\u0639"
      - "\u0623\u0633\u062F \u064A\u0647\u0648\u0630\u0627"
      - "\u0634\u062C\u0631\u0629 \u0627\u0644\u0632\u064A\u062A\u0648\u0646"
    - questionText: "\u041A\u0430\u043A\u043E\u0439 \u0441\u0438\u043C\u0432\u043E\u043B
        \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0437\u0430\u043C\u0435\u0442\u0435\u043D
        \u043D\u0430 \u043B\u0438\u0446\u0435\u0432\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
        \u041A\u0430\u043C\u043D\u044F \u041C\u0430\u0433\u0434\u0430\u043B\u044B?"
      answers:
      - "\u0417\u0432\u0435\u0437\u0434\u0430 \u0414\u0430\u0432\u0438\u0434\u0430"
      - "\u0421\u0435\u043C\u0438\u0441\u0432\u0435\u0447\u043D\u0438\u043A"
      - "\u041B\u0435\u0432 \u0418\u0443\u0434\u0435\u0439\u0441\u043A\u0438\u0439"
      - "\u041E\u043B\u0438\u0432\u043A\u043E\u0432\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E"
    correctAnswerIndex: 1
  - questionsPerLanguage:
    - questionText: What do the side panels of the Magdala Stone depict?
      answers:
      - Arches and columns possibly representing Temple architecture
      - Maps of ancient Israel
      - Scenes from daily life
      - Lists of commandments
    - questionText: "\u05DE\u05D4 \u05DE\u05EA\u05D0\u05E8\u05D9\u05DD \u05E4\u05D0\u05E0\u05DC\u05D9
        \u05D4\u05E6\u05D3 \u05E9\u05DC \u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D4?"
      answers:
      - "\u05E7\u05E9\u05EA\u05D5\u05EA \u05D5\u05E2\u05DE\u05D5\u05D3\u05D9\u05DD
        \u05D4\u05DE\u05D9\u05D9\u05E6\u05D2\u05D9\u05DD \u05DB\u05DB\u05DC \u05D4\u05E0\u05E8\u05D0\u05D4
        \u05D0\u05EA \u05D0\u05D3\u05E8\u05D9\u05DB\u05DC\u05D5\u05EA \u05D4\u05DE\u05E7\u05D3\u05E9"
      - "\u05DE\u05E4\u05D5\u05EA \u05E9\u05DC \u05D9\u05E9\u05E8\u05D0\u05DC \u05D4\u05E2\u05EA\u05D9\u05E7\u05D4"
      - "\u05E1\u05E6\u05E0\u05D5\u05EA \u05DE\u05D7\u05D9\u05D9 \u05D4\u05D9\u05D5\u05DE\u05D9\u05D5\u05DD"
      - "\u05E8\u05E9\u05D9\u05DE\u05D5\u05EA \u05E9\u05DC \u05DE\u05E6\u05D5\u05D5\u05EA"
    - questionText: "\u0645\u0627\u0630\u0627 \u062A\u0635\u0648\u0631 \u0627\u0644\u0623\u0644\u0648\u0627\u062D
        \u0627\u0644\u062C\u0627\u0646\u0628\u064A\u0629 \u0644\u062D\u062C\u0631
        \u0627\u0644\u0645\u062C\u062F\u0644\u061F"
      answers:
      - "\u0623\u0642\u0648\u0627\u0633 \u0648\u0623\u0639\u0645\u062F\u0629 \u0631\u0628\u0645\u0627
        \u062A\u0645\u062B\u0644 \u0647\u0646\u062F\u0633\u0629 \u0627\u0644\u0645\u0639\u0628\u062F"
      - "\u062E\u0631\u0627\u0626\u0637 \u0625\u0633\u0631\u0627\u0626\u064A\u0644
        \u0627\u0644\u0642\u062F\u064A\u0645\u0629"
      - "\u0645\u0634\u0627\u0647\u062F \u0645\u0646 \u0627\u0644\u062D\u064A\u0627\u0629
        \u0627\u0644\u064A\u0648\u0645\u064A\u0629"
      - "\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u0648\u0635\u0627\u064A\u0627"
    - questionText: "\u0427\u0442\u043E \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043E
        \u043D\u0430 \u0431\u043E\u043A\u043E\u0432\u044B\u0445 \u043F\u0430\u043D\u0435\u043B\u044F\u0445
        \u041C\u0430\u0433\u0434\u0430\u043B\u044C\u0441\u043A\u043E\u0433\u043E
        \u043A\u0430\u043C\u043D\u044F?"
      answers:
      - "\u0410\u0440\u043A\u0438 \u0438 \u043A\u043E\u043B\u043E\u043D\u043D\u044B,
        \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
        \u0441\u043E\u0431\u043E\u0439 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0443
        \u0445\u0440\u0430\u043C\u0430."
      - "\u041A\u0430\u0440\u0442\u044B \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E
        \u0418\u0437\u0440\u0430\u0438\u043B\u044F"
      - "\u0421\u0446\u0435\u043D\u044B \u0438\u0437 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0439
        \u0436\u0438\u0437\u043D\u0438"
      - "\u0421\u043F\u0438\u0441\u043A\u0438 \u0437\u0430\u043F\u043E\u0432\u0435\u0434\u0435\u0439"
    correctAnswerIndex: 0
  - questionsPerLanguage:
    - questionText: What is the significance of the six-petaled rosette on the top
        of the stone?
      answers:
      - "Symbol of the tribe of Judah\r"
      - Representation of the veil before the Holy of Holies
      - Decorative element with no known meaning
      - Emblem of the Roman Empire
    - questionText: "\u05DE\u05D4\u05D9 \u05DE\u05E9\u05DE\u05E2\u05D5\u05EA\u05D4
        \u05E9\u05DC \u05D4\u05E9\u05D5\u05E9\u05E0\u05D4 \u05D1\u05E2\u05DC\u05EA
        \u05E9\u05D9\u05E9\u05D4 \u05E2\u05DC\u05D9 \u05D4\u05DB\u05D5\u05EA\u05E8\u05EA
        \u05D1\u05E8\u05D0\u05E9 \u05D4\u05D0\u05D1\u05DF?"
      answers:
      - "\u05E1\u05DE\u05DC \u05E9\u05D1\u05D8 \u05D9\u05D4\u05D5\u05D3\u05D4"
      - "\u05D9\u05D9\u05E6\u05D5\u05D2 \u05D4\u05E4\u05E8\u05D5\u05DB\u05EA \u05E9\u05DC\u05E4\u05E0\u05D9
        \u05E7\u05D5\u05D3\u05E9 \u05D4\u05E7\u05D5\u05D3\u05E9\u05D9\u05DD"
      - "\u05D0\u05DC\u05DE\u05E0\u05D8 \u05D3\u05E7\u05D5\u05E8\u05D8\u05D9\u05D1\u05D9
        \u05DC\u05DC\u05D0 \u05DE\u05E9\u05DE\u05E2\u05D5\u05EA \u05D9\u05D3\u05D5\u05E2\u05D4"
      - "\u05E1\u05DE\u05DC \u05D4\u05D0\u05D9\u05DE\u05E4\u05E8\u05D9\u05D4 \u05D4\u05E8\u05D5\u05DE\u05D9\u05EA"
    - questionText: "\u0645\u0627 \u0623\u0647\u0645\u064A\u0629 \u0627\u0644\u0648\u0631\u062F\u0629
        \u0630\u0627\u062A \u0627\u0644\u0628\u062A\u0644\u0627\u062A \u0627\u0644\u0633\u062A\u0629
        \u0627\u0644\u0645\u0648\u062C\u0648\u062F\u0629 \u0623\u0639\u0644\u0649
        \u0627\u0644\u062D\u062C\u0631\u061F"
      answers:
      - "\u0631\u0645\u0632 \u0633\u0628\u0637 \u064A\u0647\u0648\u0630\u0627"
      - "\u062A\u0645\u062B\u064A\u0644 \u0627\u0644\u062D\u062C\u0627\u0628 \u0623\u0645\u0627\u0645
        \u0642\u062F\u0633 \u0627\u0644\u0623\u0642\u062F\u0627\u0633"
      - "\u0639\u0646\u0635\u0631 \u0632\u062E\u0631\u0641\u064A \u0644\u064A\u0633
        \u0644\u0647 \u0645\u0639\u0646\u0649 \u0645\u0639\u0631\u0648\u0641"
      - "\u0634\u0639\u0627\u0631 \u0627\u0644\u0625\u0645\u0628\u0631\u0627\u0637\u0648\u0631\u064A\u0629
        \u0627\u0644\u0631\u0648\u0645\u0627\u0646\u064A\u0629"
    - questionText: "\u041A\u0430\u043A\u043E\u0432\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
        \u0448\u0435\u0441\u0442\u0438\u043B\u0435\u043F\u0435\u0441\u0442\u043A\u043E\u0432\u043E\u0439
        \u0440\u043E\u0437\u0435\u0442\u043A\u0438 \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0435
        \u043A\u0430\u043C\u043D\u044F?"
      answers:
      - "\u0421\u0438\u043C\u0432\u043E\u043B \u043A\u043E\u043B\u0435\u043D\u0430
        \u0418\u0443\u0434\u0438\u043D\u0430"
      - "\u0418\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0437\u0430\u0432\u0435\u0441\u044B
        \u043F\u0435\u0440\u0435\u0434 \u0421\u0432\u044F\u0442\u0430\u044F \u0421\u0432\u044F\u0442\u044B\u0445"
      - "\u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439
        \u044D\u043B\u0435\u043C\u0435\u043D\u0442, \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
        \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E."
      - "\u0413\u0435\u0440\u0431 \u0420\u0438\u043C\u0441\u043A\u043E\u0439 \u0438\u043C\u043F\u0435\u0440\u0438\u0438"
    correctAnswerIndex: 1
  - questionsPerLanguage:
    - questionText: When was the Magdala Stone discovered?
      answers:
      - 1999
      - 2009
      - 2019
      - 2021
    - questionText: "\u05DE\u05EA\u05D9 \u05D4\u05EA\u05D2\u05DC\u05EA\u05D4 \u05D0\u05D1\u05DF
        \u05DE\u05D2\u05D3\u05DC\u05D4?"
      answers:
      - 9991
      - 9002
      - 9102
      - 1202
    - questionText: "\u0645\u062A\u0649 \u062A\u0645 \u0627\u0643\u062A\u0634\u0627\u0641
        \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644\u061F"
      answers:
      - 9991
      - 9002
      - 9102
      - 1202
    - questionText: "\u041A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D
        \u041A\u0430\u043C\u0435\u043D\u044C \u041C\u0430\u0433\u0434\u0430\u043B\u044B?"
      answers:
      - 1999
      - 2009
      - 2019
      - 2021
    correctAnswerIndex: 1
  - questionsPerLanguage:
    - questionText: "What material is the Magdala Stone made from?\r"
      answers:
      - Limestone
      - Basalt
      - Sandstone
      - "Quartzite\r"
    - questionText: "\u05DE\u05D0\u05D9\u05D6\u05D4 \u05D7\u05D5\u05DE\u05E8 \u05E2\u05E9\u05D5\u05D9\u05D4
        \u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D4?"
      answers:
      - "\u05D0\u05D1\u05DF \u05D2\u05D9\u05E8"
      - "\u05D1\u05D6\u05DC\u05EA"
      - "\u05D0\u05D1\u05DF \u05D7\u05D5\u05DC"
      - "\u05E7\u05D5\u05D5\u05E8\u05E6\u05D9\u05D8"
    - questionText: "\u0645\u0646 \u0623\u064A \u0645\u0627\u062F\u0629 \u064A\u0635\u0646\u0639
        \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644\u061F"
      answers:
      - "\u0627\u0644\u062D\u062C\u0631 \u0627\u0644\u062C\u064A\u0631\u064A"
      - "\u0627\u0644\u0628\u0627\u0632\u0644\u062A"
      - "\u0627\u0644\u062D\u062C\u0631 \u0627\u0644\u0631\u0645\u0644\u064A"
      - "\u0627\u0644\u0643\u0648\u0627\u0631\u062A\u0632\u064A\u062A"
    - questionText: "\u0418\u0437 \u043A\u0430\u043A\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430
        \u0441\u0434\u0435\u043B\u0430\u043D \u043A\u0430\u043C\u0435\u043D\u044C
        \u041C\u0430\u0433\u0434\u0430\u043B\u0430?"
      answers:
      - "\u0418\u0437\u0432\u0435\u0441\u0442\u043D\u044F\u043A"
      - "\u0411\u0430\u0437\u0430\u043B\u044C\u0442"
      - "\u041F\u0435\u0441\u0447\u0430\u043D\u0438\u043A"
      - "\u041A\u0432\u0430\u0440\u0446\u0438\u0442"
    correctAnswerIndex: 0
  - questionsPerLanguage:
    - questionText: Which city is associated with Mary Magdalene and the Magdala
        Stone?
      answers:
      - Bethlehem
      - Magdala
      - Jericho
      - Hebron
    - questionText: "\u05D0\u05D9\u05D6\u05D5 \u05E2\u05D9\u05E8 \u05E7\u05E9\u05D5\u05E8\u05D4
        \u05DC\u05DE\u05E8\u05D9\u05DD \u05D4\u05DE\u05D2\u05D3\u05DC\u05D9\u05EA
        \u05D5\u05DC\u05D0\u05D1\u05DF \u05D4\u05DE\u05D2\u05D3\u05DC\u05D0?"
      answers:
      - "\u05D1\u05D9\u05EA \u05DC\u05D7\u05DD"
      - "\u05DE\u05D2\u05D3\u05DC\u05D0"
      - "\u05D9\u05E8\u05D9\u05D7\u05D5"
      - "\u05D7\u05D1\u05E8\u05D5\u05DF"
    - questionText: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0645\u062F\u064A\u0646\u0629
        \u0627\u0644\u0645\u0631\u062A\u0628\u0637\u0629 \u0628\u0645\u0631\u064A\u0645
        \u0627\u0644\u0645\u062C\u062F\u0644\u064A\u0629 \u0648\u062D\u062C\u0631
        \u0627\u0644\u0645\u062C\u062F\u0644\u064A\u0629\u061F"
      answers:
      - "\u0628\u064A\u062A \u0644\u062D\u0645"
      - "\u0645\u062C\u062F\u0644\u0627"
      - "\u064A\u0631\u064A\u062D\u0648"
      - "\u0627\u0644\u062E\u0644\u064A\u0644"
    - questionText: "\u041A\u0430\u043A\u043E\u0439 \u0433\u043E\u0440\u043E\u0434
        \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u041C\u0430\u0440\u0438\u0435\u0439
        \u041C\u0430\u0433\u0434\u0430\u043B\u0438\u043D\u043E\u0439 \u0438 \u041C\u0430\u0433\u0434\u0430\u043B\u0438\u043D\u0441\u043A\u0438\u043C
        \u043A\u0430\u043C\u043D\u0435\u043C?"
      answers:
      - "\u0412\u0438\u0444\u043B\u0435\u0435\u043C"
      - "\u041C\u0430\u0433\u0434\u0430\u043B\u0430"
      - "\u0418\u0435\u0440\u0438\u0445\u043E\u043D"
      - "\u0425\u0435\u0432\u0440\u043E\u043D"
    correctAnswerIndex: 1
  - questionsPerLanguage:
    - questionText: What do some scholars believe the Magdala Stone symbolizes within
        the synagogue?
      answers:
      - A sundial for timekeeping
      - A replica of the Ark of the Covenant
      - A memorial for fallen soldiers
      - "A miniature version of the Temple in Jerusalem\r"
    - questionText: "\u05DE\u05D4 \u05DE\u05E1\u05DE\u05DC\u05EA \u05D0\u05D1\u05DF
        \u05D4\u05DE\u05D2\u05D3\u05DC\u05D4 \u05D1\u05D1\u05D9\u05EA \u05D4\u05DB\u05E0\u05E1\u05EA,
        \u05DC\u05D3\u05E2\u05EA \u05D7\u05DC\u05E7 \u05DE\u05D4\u05D7\u05D5\u05E7\u05E8\u05D9\u05DD?"
      answers:
      - "\u05E9\u05E2\u05D5\u05DF \u05E9\u05DE\u05E9 \u05DC\u05DE\u05D3\u05D9\u05D3\u05EA
        \u05D6\u05DE\u05DF"
      - "\u05D4\u05E2\u05EA\u05E7 \u05E9\u05DC \u05D0\u05E8\u05D5\u05DF \u05D4\u05D1\u05E8\u05D9\u05EA"
      - "\u05D0\u05E0\u05D3\u05E8\u05D8\u05D4 \u05DC\u05D7\u05D9\u05D9\u05DC\u05D9\u05DD
        \u05E9\u05E0\u05E4\u05DC\u05D5"
      - "\u05D2\u05E8\u05E1\u05D4 \u05DE\u05D9\u05E0\u05D9\u05D0\u05D8\u05D5\u05E8\u05D9\u05EA
        \u05E9\u05DC \u05D1\u05D9\u05EA \u05D4\u05DE\u05E7\u05D3\u05E9 \u05D1\u05D9\u05E8\u05D5\u05E9\u05DC\u05D9\u05DD"
    - questionText: "\u0645\u0627 \u0627\u0644\u0630\u064A \u064A\u0639\u062A\u0642\u062F
        \u0628\u0639\u0636 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0623\u0646
        \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644 \u064A\u0631\u0645\u0632
        \u0625\u0644\u064A\u0647 \u062F\u0627\u062E\u0644 \u0627\u0644\u0643\u0646\u064A\u0633\u061F"
      answers:
      - "\u0633\u0627\u0639\u0629 \u0634\u0645\u0633\u064A\u0629 \u0644\u0642\u064A\u0627\u0633
        \u0627\u0644\u0648\u0642\u062A"
      - "\u0646\u0633\u062E\u0629 \u0637\u0628\u0642 \u0627\u0644\u0623\u0635\u0644
        \u0645\u0646 \u062A\u0627\u0628\u0648\u062A \u0627\u0644\u0639\u0647\u062F"
      - "\u0646\u0635\u0628 \u062A\u0630\u0643\u0627\u0631\u064A \u0644\u0644\u062C\u0646\u0648\u062F
        \u0627\u0644\u0633\u0627\u0642\u0637\u064A\u0646"
      - "\u0646\u0633\u062E\u0629 \u0645\u0635\u063A\u0631\u0629 \u0645\u0646 \u0627\u0644\u0647\u064A\u0643\u0644
        \u0641\u064A \u0627\u0644\u0642\u062F\u0633"
    - questionText: "\u0427\u0442\u043E, \u043F\u043E \u043C\u043D\u0435\u043D\u0438\u044E
        \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0443\u0447\u0435\u043D\u044B\u0445,
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442
        \u041C\u0430\u0433\u0434\u0430\u043B\u044C\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
        \u0432 \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0435?"
      answers:
      - "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B
        \u0434\u043B\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
        \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
      - "\u041A\u043E\u043F\u0438\u044F \u041A\u043E\u0432\u0447\u0435\u0433\u0430
        \u0417\u0430\u0432\u0435\u0442\u0430"
      - "\u041C\u0435\u043C\u043E\u0440\u0438\u0430\u043B \u043F\u0430\u0432\u0448\u0438\u043C
        \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C"
      - "\u041C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F
        \u0425\u0440\u0430\u043C\u0430 \u0432 \u0418\u0435\u0440\u0443\u0441\u0430\u043B\u0438\u043C\u0435"
    correctAnswerIndex: 3
  - questionsPerLanguage:
    - questionText: Why is a replica of the Magdala Stone displayed at the synagogue
        site instead of the original?
      answers:
      - To allow tourists to touch the stone
      - To keep the original safe from weather and damage
      - Because the original was lost
      - Because the replica is more detailed
    - questionText: "\u05DC\u05DE\u05D4 \u05DE\u05D5\u05E6\u05D2 \u05D1\u05D1\u05D9\u05EA
        \u05D4\u05DB\u05E0\u05E1\u05EA \u05D1\u05DE\u05D2\u05D3\u05DC\u05D0 \u05D4\u05E2\u05EA\u05E7
        \u05E9\u05DC \u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D0 \u05D5\u05DC\u05D0
        \u05D4\u05D0\u05D1\u05DF \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9\u05EA?"
      answers:
      - "\u05DB\u05D3\u05D9 \u05DC\u05D0\u05E4\u05E9\u05E8 \u05DC\u05EA\u05D9\u05D9\u05E8\u05D9\u05DD
        \u05DC\u05D2\u05E2\u05EA \u05D1\u05D0\u05D1\u05DF"
      - "\u05DB\u05D3\u05D9 \u05DC\u05E9\u05DE\u05D5\u05E8 \u05E2\u05DC \u05D4\u05D0\u05D1\u05DF
        \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9\u05EA \u05DE\u05E4\u05E0\u05D9 \u05E0\u05D6\u05E7
        \u05D5\u05DE\u05D6\u05D2 \u05D0\u05D5\u05D5\u05D9\u05E8"
      - "\u05DB\u05D9 \u05D4\u05D0\u05D1\u05DF \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9\u05EA
        \u05D0\u05D1\u05D3\u05D4"
      - "\u05DB\u05D9 \u05D4\u05D4\u05E2\u05EA\u05E7 \u05DE\u05E4\u05D5\u05E8\u05D8
        \u05D9\u05D5\u05EA\u05E8"
    - questionText: "\u0644\u0645\u0627\u0630\u0627 \u064A\u062A\u0645 \u0639\u0631\u0636
        \u0646\u0633\u062E\u0629 \u0637\u0628\u0642 \u0627\u0644\u0623\u0635\u0644
        \u0645\u0646 \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644 \u0641\u064A
        \u0645\u0648\u0642\u0639 \u0627\u0644\u0643\u0646\u064A\u0633 \u0628\u062F\u0644\u0627\u064B
        \u0645\u0646 \u0627\u0644\u062D\u062C\u0631 \u0627\u0644\u0623\u0635\u0644\u064A\u061F"
      answers:
      - "\u0644\u0644\u0633\u0645\u0627\u062D \u0644\u0644\u0633\u064A\u0627\u062D
        \u0628\u0644\u0645\u0633 \u0627\u0644\u062D\u062C\u0631"
      - "\u0644\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0623\u0635\u0644
        \u0622\u0645\u0646\u064B\u0627 \u0645\u0646 \u0627\u0644\u0637\u0642\u0633
        \u0648\u0627\u0644\u062A\u0644\u0641"
      - "\u0644\u0623\u0646 \u0627\u0644\u0623\u0635\u0644 \u0636\u0627\u0639"
      - "\u0644\u0623\u0646 \u0627\u0644\u0646\u0633\u062E\u0629 \u0627\u0644\u0645\u062A\u0645\u0627\u062B\u0644\u0629
        \u0623\u0643\u062B\u0631 \u062A\u0641\u0635\u064A\u0644\u0627\u064B"
    - questionText: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
        \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
        \u200B\u200B\u043A\u043E\u043F\u0438\u044F \u041C\u0430\u0433\u0434\u0430\u043B\u044C\u0441\u043A\u043E\u0433\u043E
        \u043A\u0430\u043C\u043D\u044F, \u0430 \u043D\u0435 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B?"
      answers:
      - "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u0442\u0443\u0440\u0438\u0441\u0442\u0430\u043C
        \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F
        \u043A \u043A\u0430\u043C\u043D\u044E"
      - "\u0427\u0442\u043E\u0431\u044B \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
        \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u043E\u0442 \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u044B
        \u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439"
      - "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B
        \u0431\u044B\u043B \u0443\u0442\u0435\u0440\u044F\u043D"
      - "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0440\u0435\u043F\u043B\u0438\u043A\u0430
        \u0431\u043E\u043B\u0435\u0435 \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0430\u044F"
    correctAnswerIndex: 1
  - questionsPerLanguage:
    - questionText: What feature makes the Magdala Stone unique among other archaeological
        finds from ancient synagogues?
      answers:
      - It is made of gold
      - It has the oldest known carved image of a seven-branched menorah
      - It contains an inscription from King Herod
      - It was found underwater
    - questionText: "\u05DE\u05D4 \u05DE\u05D9\u05D5\u05D7\u05D3 \u05D1\u05D0\u05D1\u05DF
        \u05DE\u05D2\u05D3\u05DC\u05D0 \u05DC\u05E2\u05D5\u05DE\u05EA \u05DE\u05DE\u05E6\u05D0\u05D9\u05DD
        \u05D0\u05E8\u05DB\u05D9\u05D0\u05D5\u05DC\u05D5\u05D2\u05D9\u05D9\u05DD
        \u05D0\u05D7\u05E8\u05D9\u05DD \u05DE\u05D1\u05EA\u05D9 \u05DB\u05E0\u05E1\u05EA
        \u05E2\u05EA\u05D9\u05E7\u05D9\u05DD?"
      answers:
      - "\u05E2\u05E9\u05D5\u05D9\u05D4 \u05DE\u05D6\u05D4\u05D1"
      - "\u05D9\u05E9 \u05D1\u05D4 \u05D0\u05EA \u05D4\u05EA\u05DE\u05D5\u05E0\u05D4
        \u05D4\u05D7\u05E8\u05D5\u05D8\u05D4 \u05D4\u05E2\u05EA\u05D9\u05E7\u05D4
        \u05D1\u05D9\u05D5\u05EA\u05E8 \u05E9\u05DC \u05DE\u05E0\u05D5\u05E8\u05D4
        \u05D1\u05E2\u05DC\u05EA \u05E9\u05D1\u05E2\u05D4 \u05E7\u05E0\u05D9\u05DD"
      - "\u05DE\u05DB\u05D9\u05DC\u05D4 \u05DB\u05EA\u05D5\u05D1\u05EA \u05E9\u05DC
        \u05D4\u05DE\u05DC\u05DA \u05D4\u05D5\u05E8\u05D3\u05D5\u05E1"
      - "\u05E0\u05DE\u05E6\u05D0\u05D4 \u05DE\u05EA\u05D7\u05EA \u05DC\u05DE\u05D9\u05DD"
    - questionText: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0645\u064A\u0632\u0629
        \u0627\u0644\u062A\u064A \u062A\u062C\u0639\u0644 \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644
        \u0641\u0631\u064A\u062F\u064B\u0627 \u0645\u0646 \u0628\u064A\u0646 \u0627\u0644\u0627\u0643\u062A\u0634\u0627\u0641\u0627\u062A
        \u0627\u0644\u0623\u062B\u0631\u064A\u0629 \u0627\u0644\u0623\u062E\u0631\u0649
        \u0641\u064A \u0627\u0644\u0645\u0639\u0627\u0628\u062F \u0627\u0644\u064A\u0647\u0648\u062F\u064A\u0629
        \u0627\u0644\u0642\u062F\u064A\u0645\u0629\u061F"
      answers:
      - "\u0627\u0646\u0647\u0627 \u0645\u0635\u0646\u0648\u0639\u0629 \u0645\u0646
        \u0627\u0644\u0630\u0647\u0628"
      - "\u064A\u062D\u062A\u0648\u064A \u0639\u0644\u0649 \u0623\u0642\u062F\u0645
        \u0635\u0648\u0631\u0629 \u0645\u0646\u062D\u0648\u062A\u0629 \u0645\u0639\u0631\u0648\u0641\u0629
        \u0644\u0645\u064A\u0646\u0648\u0631\u0627\u0647 \u0630\u0627\u062A \u0633\u0628\u0639\u0629
        \u0641\u0631\u0648\u0639"
      - "\u0648\u064A\u062D\u062A\u0648\u064A \u0639\u0644\u0649 \u0646\u0642\u0634
        \u0644\u0644\u0645\u0644\u0643 \u0647\u064A\u0631\u0648\u062F\u0633"
      - "\u062A\u0645 \u0627\u0644\u0639\u062B\u0648\u0631 \u0639\u0644\u064A\u0647
        \u062A\u062D\u062A \u0627\u0644\u0645\u0627\u0621"
    - questionText: "\u041A\u0430\u043A\u0430\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C
        \u0434\u0435\u043B\u0430\u0435\u0442 \u041C\u0430\u0433\u0434\u0430\u043B\u044C\u0441\u043A\u0438\u0439
        \u043A\u0430\u043C\u0435\u043D\u044C \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C
        \u0441\u0440\u0435\u0434\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
        \u043D\u0430\u0445\u043E\u0434\u043E\u043A \u0438\u0437 \u0434\u0440\u0435\u0432\u043D\u0438\u0445
        \u0441\u0438\u043D\u0430\u0433\u043E\u0433?"
      answers:
      - "\u041E\u043D \u0441\u0434\u0435\u043B\u0430\u043D \u0438\u0437 \u0437\u043E\u043B\u043E\u0442\u0430"
      - "\u0417\u0434\u0435\u0441\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u0434\u0440\u0435\u0432\u043D\u0435\u0439\u0448\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0435
        \u0440\u0435\u0437\u043D\u043E\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
        \u0441\u0435\u043C\u0438\u0441\u0432\u0435\u0447\u043D\u0438\u043A\u0430"
      - "\u041E\u043D \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043D\u0430\u0434\u043F\u0438\u0441\u044C
        \u0446\u0430\u0440\u044F \u0418\u0440\u043E\u0434\u0430"
      - "\u0415\u0433\u043E \u043D\u0430\u0448\u043B\u0438 \u043F\u043E\u0434 \u0432\u043E\u0434\u043E\u0439"
    correctAnswerIndex: 1
  - questionsPerLanguage:
    - questionText: Where is the original Magdala Stone currently located?
      answers:
      - Israel Museum in Jerusalem
      - Vatican Museums
      - "Beit Shemesh\r"
      - "British Museum in London\r"
    - questionText: "\u05D4\u05D9\u05DB\u05DF \u05E0\u05DE\u05E6\u05D0\u05EA \u05DB\u05D9\u05D5\u05DD
        \u05D0\u05D1\u05DF \u05DE\u05D2\u05D3\u05DC\u05D4 \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9\u05EA?"
      answers:
      - "\u05DE\u05D5\u05D6\u05D9\u05D0\u05D5\u05DF \u05D1\u05D9\u05E8\u05D5\u05E9\u05DC\u05D9\u05DD,
        \u05D9\u05E9\u05E8\u05D0\u05DC"
      - "\u05DE\u05D5\u05D6\u05D9\u05D0\u05D5\u05E0\u05D9 \u05D4\u05D5\u05D5\u05EA\u05D9\u05E7\u05DF"
      - "\u05D1\u05D9\u05EA \u05E9\u05DE\u05E9"
      - "\u05DE\u05D5\u05D6\u05D9\u05D0\u05D5\u05DF \u05D1\u05DC\u05D5\u05E0\u05D3\u05D5\u05DF,
        \u05D1\u05E8\u05D9\u05D8\u05E0\u05D9\u05D4"
    - questionText: "\u0623\u064A\u0646 \u064A\u0642\u0639 \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644
        \u0627\u0644\u0623\u0635\u0644\u064A \u062D\u0627\u0644\u064A\u064B\u0627\u061F"
      answers:
      - "\u0645\u062A\u062D\u0641 \u0625\u0633\u0631\u0627\u0626\u064A\u0644 \u0641\u064A
        \u0627\u0644\u0642\u062F\u0633"
      - "\u0645\u062A\u0627\u062D\u0641 \u0627\u0644\u0641\u0627\u062A\u064A\u0643\u0627\u0646"
      - "\u0628\u064A\u062A \u0634\u064A\u0645\u0634"
      - "\u0627\u0644\u0645\u062A\u062D\u0641 \u0627\u0644\u0628\u0631\u064A\u0637\u0627\u0646\u064A
        \u0641\u064A \u0644\u0646\u062F\u0646"
    - questionText: "\u0413\u0434\u0435 \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
        \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u043A\u0430\u043C\u0435\u043D\u044C \u041C\u0430\u0433\u0434\u0430\u043B\u0430?"
      answers:
      - "\u041C\u0443\u0437\u0435\u0439 \u0418\u0437\u0440\u0430\u0438\u043B\u044F
        \u0432 \u0418\u0435\u0440\u0443\u0441\u0430\u043B\u0438\u043C\u0435"
      - "\u041C\u0443\u0437\u0435\u0438 \u0412\u0430\u0442\u0438\u043A\u0430\u043D\u0430"
      - "\u0411\u0435\u0439\u0442-\u0428\u0435\u043C\u0435\u0448"
      - "\u0411\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u043C\u0443\u0437\u0435\u0439
        \u0432 \u041B\u043E\u043D\u0434\u043E\u043D\u0435"
    correctAnswerIndex: 2
