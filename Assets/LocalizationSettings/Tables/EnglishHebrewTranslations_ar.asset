    m_Metadata:
      m_Items: []
  - m_Id: 2553196907954176
    m_Localized: "\u0627\u0628\u062D\u062B \u0639\u0646 \u0627\u0644\u0623\u064A\u0642\u0648\u0646\u0627\u062A
      \u0648\u0627\u0646\u0642\u0631 \u0639\u0644\u064A\u0647\u0627!"
    m_Metadata:
      m_Items: []
  - m_Id: 3537021246996480
    m_Localized: "\u064A\u0643\u0645\u0644"
    m_Metadata:
      m_Items: []
  - m_Id: 3537592746082304
    m_Localized: "\u0645\u062A\u0627\u0628\u0639\u0629 \u0625\u0644\u0649 \u0627\u0644\u0627\u062E\u062A\u0628\u0627\u0631"
    m_Metadata:
      m_Items: []
  - m_Id: 3541684298022912
    m_Localized: "\u062A\u062E\u0645\u064A\u0646 \u0627\u0633\u0645 \u0627\u0644\u0631\u0645\u0632"
    m_Metadata:
      m_Items: []
  - m_Id: 3569314778939392
    m_Localized: "\u0641\u064A \u0625\u0637\u0627\u0631 \u062F\u0648\u0631\u0629
      \u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0648\u0627\u0642\u0639 \u0627\u0644\u0645\u0639\u0632\u0632
      \u0641\u064A \u0643\u0644\u064A\u0629 \u0628\u0631\u0627\u0648\u062F\u0627
      \u0641\u064A \u0643\u0631\u0645\u064A\u0626\u064A\u0644\u060C \u0637\u064F\u0644\u0628
      \u0645\u0646\u0627 \u0625\u0646\u0634\u0627\u0621 \u0645\u0634\u0631\u0648\u0639
      \u062D\u0648\u0644 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u062A\u0631\u0627\u062B
      \u0627\u0644\u062B\u0642\u0627\u0641\u064A. \u0644\u0642\u062F \u0627\u062E\u062A\u0631\u0646\u0627
      \u0625\u0646\u0634\u0627\u0621 \u062A\u0637\u0628\u064A\u0642 \u0627\u0644\u0648\u0627\u0642\u0639
      \u0627\u0644\u0645\u0639\u0632\u0632 \u0627\u0644\u062A\u0641\u0627\u0639\u0644\u064A
      \u0627\u0644\u0630\u064A \u064A\u0639\u0644\u0645 \u0627\u0644\u0642\u0644\u064A\u0644
      \u0639\u0646 \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644.\r\n\r\n\u064A\u062A\u0636\u0645\u0646
      \u0647\u0630\u0627 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0645\u062C\u0645\u0648\u0639\u0629
      \u0645\u062A\u0646\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u064A\u0632\u0627\u062A:\r\n)1(
      \u062C\u0648\u0644\u0629 \u0633\u0631\u064A\u0639\u0629 \u0641\u064A \u0627\u0644\u0645\u0643\u0627\u0646
      \u0627\u0644\u0630\u064A \u062A\u0645 \u0627\u0644\u0639\u062B\u0648\u0631
      \u0641\u064A\u0647 \u0639\u0644\u0649 \u0627\u0644\u062D\u062C\u0631.\r\n)2(
      \u062C\u0648\u0644\u0629 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u0644\u0643\u0627\u0645\u064A\u0631\u0627
      \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0643 \u062A\u062A\u0636\u0645\u0646
      \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644\u060C \u0645\u0639
      \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0639\u0646\u0647 \u0648\u0644\u0639\u0628\u0629
      \u0627\u0644\u0645\u0634\u0646\u0642\u0629 \u0645\u0639 \u0627\u0644\u0623\u062F\u0644\u0629
      \u0627\u0644\u062A\u064A \u062A\u0645 \u0625\u0646\u0634\u0627\u0624\u0647\u0627
      \u0628\u0648\u0627\u0633\u0637\u0629 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064A.\r\n)3(
      \u0627\u062E\u062A\u0628\u0627\u0631 \u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649
      \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0625\u0636\u0627\u0641\u064A\u0629
      \u062D\u0648\u0644 \u062D\u062C\u0631 \u0627\u0644\u0645\u062C\u062F\u0644\u060C
      \u0645\u0639 \u0625\u062D\u0635\u0627\u0626\u064A\u0627\u062A \u062D\u0648\u0644
      \u0625\u0646\u062C\u0627\u0632\u0627\u062A\u0643 \u0641\u064A\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 3578566264324096
    m_Localized: "\u0644\u0642\u062F \u0648\u0635\u0644\u062A \u0625\u0644\u0649
      \u0627\u0644\u0646\u0647\u0627\u064A\u0629!\r\n\r\n\u0646\u0634\u0643\u0631\u0643
      \u0639\u0644\u0649 \u062A\u062C\u0631\u0628\u0629 \u0627\u0644\u062C\u0648\u0644\u0629
      \u0645\u0639\u0646\u0627!"
    m_Metadata:
      m_Items: []
