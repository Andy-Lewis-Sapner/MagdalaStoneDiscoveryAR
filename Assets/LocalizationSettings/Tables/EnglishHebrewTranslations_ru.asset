      \u041C\u0430\u0433\u0434\u0430\u043B\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 701397146107904
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0432\u0438\u043A\u0442\u043E\u0440\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 702728015544320
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 702790825246720
    m_Localized: "\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u0442\u0435\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2553196907954176
    m_Localized: "\u0418\u0449\u0438\u0442\u0435 \u0441\u0438\u043C\u0432\u043E\u043B\u044B
      \u0438 \u043A\u043B\u0438\u043A\u0430\u0439\u0442\u0435 \u043F\u043E \u043D\u0438\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3537021246996480
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3537592746082304
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0432\u0438\u043A\u0442\u043E\u0440\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 3541684298022912
    m_Localized: "\u0423\u0433\u0430\u0434\u0430\u0439 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0441\u0438\u043C\u0432\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3569314778939392
    m_Localized: "\u0412 \u0440\u0430\u043C\u043A\u0430\u0445 \u043A\u0443\u0440\u0441\u0430
      \u041F\u0440\u043E\u0435\u043A\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0439
      \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0432 \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435
      \u0411\u0440\u0430\u0443\u0434\u0435 \u0432 \u041A\u0430\u0440\u043C\u0438\u044D\u043B\u0435
      \u043D\u0430\u043C \u043F\u043E\u0440\u0443\u0447\u0438\u043B\u0438 \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u043F\u0440\u043E\u0435\u043A\u0442, \u043F\u043E\u0441\u0432\u044F\u0449\u0451\u043D\u043D\u044B\u0439
      \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u043C\u0443 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u044E.
      \u041C\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0439
      \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442
      \u043E \u041A\u0430\u043C\u043D\u0435 \u041C\u0430\u0433\u0434\u0430\u043B\u044B.\r\n\r\n\u042D\u0442\u043E
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
      \u0432 \u0441\u0435\u0431\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0444\u0443\u043D\u043A\u0446\u0438\u0438:\r\n(1) \u0411\u044B\u0441\u0442\u0440\u044B\u0439
      \u0442\u0443\u0440 \u043F\u043E \u043C\u0435\u0441\u0442\u0443 \u043D\u0430\u0445\u043E\u0434\u043A\u0438
      \u041A\u0430\u043C\u043D\u044F.\r\n(2) \u0422\u0443\u0440 \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u043A\u0430\u043C\u0435\u0440\u044B, \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0438\u0439
      \u0432 \u0441\u0435\u0431\u044F \u041A\u0430\u043C\u0435\u043D\u044C \u041C\u0430\u0433\u0434\u0430\u043B\u044B,
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E \u043D\u0451\u043C
      \u0438 \u0438\u0433\u0440\u0443 \u0432 \u0432\u0438\u0441\u0435\u043B\u0438\u0446\u0443
      \u0441 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430\u043C\u0438,
      \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u0435\u043C\u044B\u043C\u0438
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u043E\u043C.\r\n(3)
      \u0412\u0438\u043A\u0442\u043E\u0440\u0438\u043D\u0430 \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u0437\u043D\u0430\u043D\u0438\u0439 \u043E \u041A\u0430\u043C\u043D\u0435
      \u041C\u0430\u0433\u0434\u0430\u043B\u044B \u0441 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u043E\u0439 \u0432\u0430\u0448\u0438\u0445
      \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3578566264324096
    m_Localized: "\u0412\u044B \u0434\u043E\u0448\u043B\u0438 \u0434\u043E \u043A\u043E\u043D\u0446\u0430!\r\n\r\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0447\u0442\u043E \u043F\u043E\u0441\u0435\u0442\u0438\u043B\u0438\r\n\u041A\u0430\u043C\u0435\u043D\u044C
      \u041C\u0430\u0433\u0434\u0430\u043B\u044B \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043D\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
